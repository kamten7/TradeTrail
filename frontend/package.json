{
  "name": "tradetrail-browser-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "format": "prettier --write \"{customer,merchant}/src/**/*.{vue,ts,css}\" \"{customer,merchant}/vite.config.ts\" \"shared/*.ts\" \"tests/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"{customer,merchant}/src/**/*.{vue,ts,css}\" \"{customer,merchant}/vite.config.ts\" \"shared/*.ts\" \"tests/*.ts\" playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.9.10"
  }
}
